{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Zig1375/EscApp-Games/main/schema/shared.schema.json",
  "title": "EscApp shared module",
  "description": "What many games need (shared/<id>.json): applied to a game whose module requires it, or by itself to every game on an engine. Otherwise the same as a game module.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "format", "name", "note", "fixes"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "module.schema.json#/$defs/slug" },
    "revision": { "type": "integer", "minimum": 1 },
    "format": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "note": { "$ref": "module.schema.json#/$defs/note" },
    "credits": { "$ref": "module.schema.json#/$defs/credits" },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine"],
      "properties": {
        "engine": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unity", "unreal", "rpgmaker-xp", "rpgmaker-vx", "rpgmaker-vxace"] },
          "description": "Engines EscApp already recognises: UnityPlayer.dll, an Engine folder, Game.ini."
        }
      }
    },
    "requires": { "$ref": "module.schema.json#/$defs/requires" },
    "fixes": { "$ref": "module.schema.json#/$defs/fixes" }
  }
}
